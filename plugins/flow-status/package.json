{
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.13",
    "@types/node": "24.19.2",
    "clean-code-tools": "1.0.7",
    "eslint": "10.11.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "69.0.0",
    "fallow": "3.27.0",
    "globals": "17.12.0",
    "knip": "6.37.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "name": "herdr-flow-status",
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "bun run check:static && bun run test",
    "check:fallow": "fallow dead-code --summary --quiet && fallow dupes --summary --quiet",
    "check:format": "prettier --check --ignore-unknown .",
    "check:knip": "knip --no-progress --no-config-hints",
    "check:root": "bun run check:format && bun run check:knip && bun run check:fallow",
    "check:static": "bun run check:root && bun run build && bun run lint && bun run typecheck",
    "fix": "eslint src tests --fix",
    "format": "prettier --write --ignore-unknown .",
    "format-check": "prettier --check --ignore-unknown src tests",
    "lint": "eslint src tests --max-warnings 0",
    "test": "bun test ./tests",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tests/tsconfig.json --noEmit",
    "start": "bun src/main.ts",
    "check:flow": "bun src/checkFlow.ts"
  },
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "zod": "4.3.6"
  }
}
